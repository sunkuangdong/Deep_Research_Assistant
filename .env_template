# Deep Research Assistant — environment variable template (English)
# Usage: cp .env_template .env  then fill in real values
# Do NOT commit .env to Git

# ---- Required: LLM (OpenAI-compatible) ----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-6-luna
MODEL_REASONING_EFFORT=none
MODEL_MAX_INPUT_TOKENS=131072

# ---- Required: web search (Bocha) ----
BOCHA_API_KEY=

# ---- Optional: Langfuse observability ----
# Create a project in Langfuse and copy its project-scoped API keys here.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_TRACING_ENVIRONMENT=evaluation
# LANGFUSE_SAMPLE_RATE=1

# ---- Optional: local Ollama example ----
# Uncomment below and comment out the official OpenAI settings above.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama-local-key
# MODEL_NAME=qwen2.5:7b
