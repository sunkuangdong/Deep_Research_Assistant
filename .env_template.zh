# Deep Research Assistant — 环境变量模板（中文）
# 用法：cp .env_template.zh .env  然后填入真实值
# 注意：.env 不要提交到 Git

# ---- 必填：LLM（OpenAI 兼容）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-6-luna
MODEL_REASONING_EFFORT=none
MODEL_MAX_INPUT_TOKENS=131072

# ---- 必填：联网搜索（Bocha）----
BOCHA_API_KEY=

# ---- 可选：Langfuse 可观测性 ----
# 在 Langfuse 中创建项目后，将该项目的 API Key 填写到这里。
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=true
# LANGFUSE_TRACING_ENVIRONMENT=evaluation
# LANGFUSE_SAMPLE_RATE=1

# ---- 可选：本地 Ollama 示例 ----
# 取消下方注释，并注释掉上方官方 OpenAI 配置。
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama-local-key
# MODEL_NAME=qwen2.5:7b
